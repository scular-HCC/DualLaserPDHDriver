			)
			(justify left)
		)
		(uuid "45759767-c44f-4889-b230-07b977593f3d")
	)
	(text "CARD ADDRESS is hard-strapped: U201 ADDR (pin 1) ties to SDA, so the ADS1115 answers at 0x4A. No jumper to mis-set."
		(exclude_from_sim no)
		(at 20.574 453.39 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "5545faad-075c-4b84-9f66-2aff28620eeb")
	)
	(text "LO1/LO2 arrive via front-panel SMA (J204 = LO1, J205 = LO2) per backplane rule - the c20 spare bus pin is fallback only."
		(exclude_from_sim no)
		(at 20.574 438.15 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
