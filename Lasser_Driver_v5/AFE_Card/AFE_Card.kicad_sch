	(text "AFE CARD rev B - machine-extracted v3 PhotoDiodes/OPA859 TIAs/AD831 PhaseRef (BOTH channels) + universal bus interface."
		(exclude_from_sim no)
		(at 20.574 422.91 0)
		(effects
