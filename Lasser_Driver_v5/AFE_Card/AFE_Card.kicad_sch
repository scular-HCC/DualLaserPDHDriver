	(text "Wiring is by net label at every pin (no graphic wires yet). Original v3 refdes kept for cross-reference."
		(exclude_from_sim no)
		(at 20.574 427.99 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "9763f68c-fe1f-4daf-b514-9d3d841e284e")
	)
	(text "DAC 0..2.5V moves ERRn_BUF DC over 1.98..2.97V (15uV/LSB). Powers up at midscale (RSTSEL=VLOGIC) = 2.48V, so an unwritten DAC is safe."
		(exclude_from_sim no)
		(at 20.574 468.63 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "c0598658-2525-46b8-887a-904ae2025086")
	)
	(text "AGND from v3 mapped to single GND (star at DIN). Second LT3042 (+5.5V) was netlist-excluded in v3 - not carried over."
		(exclude_from_sim no)
		(at 20.574 463.55 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "cdb2a4d8-eb8e-426a-88a9-0e320b31d129")
	)
	(text "FGA01FC photodiodes (PD1/PD2) mount ON the front panel; only their three leads reach the board (Optical:PD_TO46_FGA01FC_3pin, 3 holes on a 2.5mm circle). Pin 1=K, 2=CASE, 3=A. Supplied with the optics - not on the BOM. The ANODE must sit millimetres from the TIA input: it is the compensated summing node (Cf 1pF), so place U30/U31 directly behind their diodes."
		(exclude_from_sim no)
		(at 20.574 433.07 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "d6cc03aa-739c-4ff4-8bb6-7066e5cd7337")
	)
	(text "ERR out: ERRn_FILT -> U202/U203 OPA192 inverting x4.99 referenced to VBn -> 47R series -> ERRn_BUS. Zero error = VREF_MID (2.5V)."
		(exclude_from_sim no)
		(at 20.574 443.23 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "e6c2403e-99db-4cd1-8b21-27a45adc0e2d")
	)
	(text "ERR OFFSET NULL is automatic - no trimpot. U206 AD5696R (0x0E) VOUTA/VOUTB inject via R146/R147 100k into VB1/VB2."
		(exclude_from_sim no)
		(at 20.574 463.55 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "f57d266e-7d5f-4bf0-aeaa-2330c41b423c")
	)
	(text "0x48/0x49 belong to the CH1/CH2 ADS1115s, so the AFE uses ADDR->SDA (ADS1115 ds). Backplane GA pins a20/c18/c19 (GA*_BP) intentionally unused."
		(exclude_from_sim no)
		(at 20.574 458.47 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "fa8c3c4d-fea8-4ee0-a55e-f0cf1269e6dd")
	)
