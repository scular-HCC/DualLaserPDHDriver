		(uuid "2a884526-f12c-4535-8f6e-a7c02c3ee969")
	)
	(text "U201 ADS1115 digitizes PD DC levels (RC taps off TIA outputs); pin numbers per TI datasheet (MSOP-10)."
		(exclude_from_sim no)
		(at 20.574 448.31 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "43981b75-dec7-47d2-a7e4-9d74d4b675db")
	)
	(text "LO in (front SMA)"
		(exclude_from_sim no)
		(at 28.956 285.75 0)
		(effects
			(font
				(size 2.54 2.54)
