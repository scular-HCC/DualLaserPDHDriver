	(text "I2C: Teensy = master; MCU_SDA/SCL merged onto card net SDA/SCL (also serves CDCE913); bus pullups = existing R112/R113 4.7k (Clock sheet) - the ONLY pullups on the whole backplane bus."
		(exclude_from_sim no)
		(at 38.608 408.432 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "003a1e71-d968-4352-bcce-bb9904f2bb91")
	)
	(text "VoltageMonitor windows +/-15V, +/-5V, +/-6V_TEC, +5V_LASER, 3V3, 1V8. +/-18V blades (P5-P8) pass through UNMONITORED."
