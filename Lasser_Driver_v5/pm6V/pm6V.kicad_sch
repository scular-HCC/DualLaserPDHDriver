	(text "DIN 41612 BACKPLANE CONNECTOR  (Type H, 24 signal + 8 power):\nBoard:  TE/Erni 374144-E  (right-angle male, 24+8, gold THT).\nMate:   TE/Erni 294711-E  (vertical female, backplane side).\n8 power blades ~10 A (+/-6V_TEC, +/-22V, returns); 24 signal ~2 A.\nAC / transformer leads stay on screw terminals J1-J5."
		(exclude_from_sim no)
		(at 22.352 -13.716 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e3012d8-3961-4e9c-935b-a8955b010be6")
	)
	(text "Q17 MJL21193 PNP: emitter at raw -16.6 V; collector = -6 V output"
