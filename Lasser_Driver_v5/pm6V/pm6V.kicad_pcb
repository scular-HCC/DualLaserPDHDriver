	(footprint "Heatsinks:TO-264-3_Vertical_HS657-25ABPE"
		(layer "F.Cu")
		(uuid "c3d77d0e-8008-4ddd-900f-98bffe31cd28")
		(at 100.025 30.925)
		(descr "TO-264-3 vertical transistor (RM 5.45mm, MJL21193/MJL21194) bolted to a Wakefield 657-series vertical board-mount heat sink (extrusion 6533 - identical base/pin pattern for 657-10/15/20/25ABPE; the board uses 657-10ABPE, 25.4mm tall, to fit the 100x160 Eurocard). Combined footprint: pads 1/2/3 = device B/C/E (drill 1.5mm); two unnamed plated pads = heat-sink wave-solder pins (Wakefield 6533 extrusion, 0.093in/2.4mm pins on 1.000in/25.4mm centers, centred on device tab axis). Heat-sink base 41.9 x 25.4mm; device mounting hole 0.144in/3.7mm at 21.6mm up the vertical face (NOT a board hole). Pad pitch and pin span are exact; the pin-row depth (Y) is set 8.0mm behind the lead plane (~4mm into the base per the 6533 drawing) and should be verified against the physical part before fabrication. Isolate device tab from sink with thermal pad (Same Sky WTI7R1F0-1.00X0.75 or equiv).")
		(tags "TO-264 TO-247 heatsink 657-25ABPE Wakefield vertical MJL21193 MJL21194 power pass transistor")
