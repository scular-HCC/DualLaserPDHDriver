	(text "v6 change (2026-07-26):  U24 op-amp inputs corrected -- pins 3 (IN+) and 4 (IN-) swapped."
		(exclude_from_sim no)
		(at 176.0 106.0 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "9f168ac6-873a-4394-a4f6-d41e8f997792")
	)
	(text "Feedback (C76 / R94) was on IN+ = positive feedback; the lock-servo integrator latched to a rail."
		(exclude_from_sim no)
		(at 176.0 109.4 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "46f4ce9a-9da6-4bfd-866e-c3090e6e1da8")
	)
	(text "This was inherited from v3 / v5.  Now a proper inverting Miller integrator referenced to VREF_MID."
		(exclude_from_sim no)
		(at 176.0 112.8 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "72721e56-7449-49c1-82db-9e368c31977f")
	)
	(text "PCB rerouted to match (U24 pad 3 -> VREF_MID, pad 4 -> N_U24_INP)."
		(exclude_from_sim no)
		(at 176.0 116.2 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
